# App
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Comma-separated browser origins. Leave empty in development to reflect
# request origin. In production/staging an empty value denies browser CORS
# (native mobile clients are unaffected).
CORS_ORIGINS=

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=bloc
DATABASE_USER=bloc
DATABASE_PASSWORD=bloc

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth0
# Tenant domain (no protocol). Example: bloc-prod.us.auth0.com
AUTH0_DOMAIN=YOUR_AUTH0_DOMAIN
# API Identifier you set when creating the API in Auth0 (must match the
# `audience` requested by the mobile client).
AUTH0_AUDIENCE=https://api.bloc.app
#
# IMPORTANT — two different Auth0 applications:
#   1) Native "Bloc Mobile" (client ID in the Expo app) → Google / Apple PKCE only.
#      Do NOT put that Client ID here.
#   2) Regular Web "Bloc API Auth" (confidential) → email/password proxy only.
#      AUTH0_CLIENT_ID / AUTH0_CLIENT_SECRET must be THIS Regular Web app.
#
# Enable Grant Types → Password on the Regular Web app. Keep the secret server-side.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Database connection for email/password users (default below).
AUTH0_DB_CONNECTION=Username-Password-Authentication
# Custom claim namespace — wire roles/email/etc. via an Auth0 Post-Login Action
# (e.g. api.accessToken.setCustomClaim('https://bloc.app/roles', roles)).
AUTH0_CUSTOM_CLAIM_NAMESPACE=https://bloc.app/
# Optional: JWKS cache TTL in ms (default 10 min).
AUTH0_JWKS_CACHE_TTL_MS=600000

# AWS
AWS_REGION=us-east-1
S3_BUCKET=
CLOUDFRONT_DOMAIN=

# Mux
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# PostHog
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENABLED=false

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
